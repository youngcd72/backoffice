<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    SQL File Name : InactiveUserLockBatchMapper.xml
    Description   : inactiveUserLockJob 전용 Mapper. Reader/Writer는 statement ID(namespace + id)로 호출한다.

    ==개정이력========================================
    수정일     수정자   Version    Query Id
    ========== ======= =========   ===================
    2026.10.09  ywkim    0.1       최초등록
-->
<mapper namespace="kr.or.coder.batch.job.system.inactiveuserlock.mapper.InactiveUserLockBatchMapper">

    <!--
           기준일시 이전에 마지막으로 접속한 사용 중 사용자를 Cursor로 조회한다.
           PostgreSQL JDBC는 autoCommit=false 일 때만 fetchSize 단위로 커서를 사용한다.
           Cursor Reader는 Step 트랜잭션 밖에서 별도 세션을 열기 때문에 대상 건수가 매우 많으면
           메모리 사용량을 확인하고, 필요 시 키 범위 분할(Partitioning)을 검토한다.
           작성자 : ywkim
      -->
    <select id="selectInactiveUserList" fetchSize="1000"
            resultType="kr.or.coder.batch.job.system.inactiveuserlock.InactiveUser">
        /* InactiveUserLockBatchMapper.selectInactiveUserList 기준일시 이전에 마지막으로 접속한 사용 중 사용자를 Cursor로 조회한다. */
        SELECT USR_ID,
               USR_NM,
               FINA_ACC_DTTM
        FROM TB_USR_M
        WHERE USE_YN = 'Y'
          AND COALESCE(USR_LOCK_YN, 'N') = 'N'
          AND FINA_ACC_DTTM &lt; #{baseDttm}
        ORDER BY USR_ID
    </select>

    <!--
           사용자를 잠금 처리한다.
           작성자 : ywkim
      -->
    <update id="updateUserLock" parameterType="kr.or.coder.batch.job.system.inactiveuserlock.InactiveUser">
        /* InactiveUserLockBatchMapper.updateUserLock 사용자를 잠금 처리한다. */
        UPDATE TB_USR_M
           SET USR_LOCK_YN   = 'Y',
               USR_LOCK_DTTM = #{usrLockDttm},
               FINA_REGR_ID  = #{finaRegrId},
               FINA_REG_DT   = CURRENT_TIMESTAMP
         WHERE USR_ID = #{usrId}
    </update>

</mapper>
