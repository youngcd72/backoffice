<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    SQL File Name : FavoriteMapper.xml
    Description   : 사용자 즐겨찾기 메뉴(TB_PRGM_FAV_L) MyBatis Mapper

    ==개정이력========================================
    수정일     수정자   Version    Query Id
    ========== ======= =========   ===================
    2026.10.09  ywkim    0.1       최초등록
-->
<mapper namespace="kr.or.coder.common.frame.mapper.FavoriteMapper">

    <!--
           사용자의 즐겨찾기 메뉴 목록을 정렬순번 순으로 조회 (사용 중인 메뉴만)
           작성자 : ywkim
      -->
    <select id="selectFavoriteList" resultType="kr.or.coder.common.frame.dto.favorite.FavoriteResponse">
        /* FavoriteMapper.selectFavoriteList 사용자의 즐겨찾기 메뉴 목록을 정렬순번 순으로 조회 (사용 중인 메뉴만) */
        SELECT F.MENU_ID,
               M.MENU_NM,
               M.PRGM_ID,
               F.ALIN_SEQ
        FROM TB_PRGM_FAV_L F
        JOIN TB_MENU_M M
          ON M.MENU_ID = F.MENU_ID
        WHERE F.USR_ID = #{usrId}
          AND M.USE_YN = 'Y'
        ORDER BY F.ALIN_SEQ NULLS LAST, M.MENU_NM
    </select>

</mapper>
