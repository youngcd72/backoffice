<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    SQL File Name : CommonSql.xml
    Description   : 여러 Mapper 가 함께 쓰는 SQL 조각 (매퍼 인터페이스 없음, refid="CommonSql.{id}" 로 include)

    ==개정이력========================================
    수정일     수정자   Version    Query Id
    ========== ======= =========   ===================
    2026.10.20  ywkim    0.1       최초등록 (validAuthGroupCondition)
-->
<mapper namespace="CommonSql">

    <!--
           사용자의 권한그룹 소속이 유효한 조건 (사용 중인 권한그룹, 오늘이 소속 적용기간과 그룹 적용기간 안)
           별칭: R = TB_USR_AUTH_GRP_R, G = TB_AUTH_GRP_M
           작성자 : ywkim
      -->
    <sql id="validAuthGroupCondition">
        AND G.USE_YN = 'Y'
        AND TO_CHAR(CURRENT_DATE, 'YYYYMMDD') BETWEEN COALESCE(R.ST_DT, '00000000') AND COALESCE(R.END_DT, '99991231')
        AND TO_CHAR(CURRENT_DATE, 'YYYYMMDD') BETWEEN COALESCE(G.ST_DT, '00000000') AND COALESCE(G.END_DT, '99991231')
    </sql>

</mapper>
